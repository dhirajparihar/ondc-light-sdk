{
  "name": "ondc-light-sdk",
  "version": "1.0.0",
  "description": "Lightweight, production-ready, open-source Node.js/TypeScript SDK wrapper for ONDC Beckn Protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.js tests/*.test.ts",
    "test:validation": "node --experimental-strip-types --test tests/OndcValidation.test.ts"
  },
  "keywords": [
    "ondc",
    "beckn",
    "ed25519",
    "blake2b",
    "dpi",
    "ecommerce",
    "india",
    "sdk"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "libsodium-wrappers": "^0.7.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.10.2",
    "express": "^4.21.2",
    "typescript": "^5.7.2"
  }
}
