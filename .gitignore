# ==============================================================================
# ONDC Light SDK - Git Ignore Configuration
# ==============================================================================

# 1. Dependency Directories
node_modules/
jspm_packages/
web_modules/

# 2. Build & Compilation Artifacts
dist/
build/
lib/
*.tsbuildinfo

# 3. Environment Variables & ONDC Private Cryptographic Keys
# (Never commit private keys, signing seeds, or live credentials to git)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12
*.pfx
secrets/
private_keys/

# 4. Logs and Debugging Traces
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Testing & Code Coverage
coverage/
.nyc_output/
reports/
test-results/

# 6. Operating System & Local Editor Cache
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# 7. IDE & Tooling Caches
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.eslintcache

# 8. Temporary & Backup Files
*.bak
*.tmp
*.temp
scratch/

# 9. Internal Strategic & Launch Documents
LAUNCH_PLAYBOOK.md

